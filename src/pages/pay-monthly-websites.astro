---
import BaseLayout from "../layouts/BaseLayout.astro";
import PriceCard from "../components/PriceCard.astro";
import FAQ from "../components/FAQ.astro";
import Steps from "../components/Steps.astro";
import LocalBand from "../components/LocalBand.astro";
import Hero from "../components/Hero.astro";
import Button from "../components/Button.astro";
import CTA from "../components/CTA.astro";
import { route } from "../config/routes";
import { byId, setupLine } from "../data/services";
import { planCard, serviceSchema } from "../data/plans";

const svc = byId("pay-monthly-websites");
const faqs = [
  {
    "question": "How much does a pay monthly website cost?",
    "answer": "Our Website Starter package costs £79 per month plus VAT, with a £149 initial setup fee plus VAT. Additional pages and features are available at an extra cost."
  },
  {
    "question": "Is there a minimum contract?",
    "answer": "Yes. Website Starter is based on a 24-month minimum agreement. Your contract will explain the payment terms, cancellation process and options for your website at the end of the agreement."
  },
  {
    "question": "Can I use my existing domain name?",
    "answer": "Yes. If you already have a domain name, we can normally connect it to your new website, provided you have the necessary access."
  },
  {
    "question": "Will my website appear on Google?",
    "answer": "Your website will include basic SEO setup to help search engines discover and understand its pages. However, appearing prominently for competitive searches usually requires additional optimisation and ongoing work."
  },
  {
    "question": "Can I add more pages later?",
    "answer": "Yes. Additional pages and features can be quoted separately as your business grows."
  },
  {
    "question": "Can you update my website?",
    "answer": "Limited content amendments are included within your package. Larger changes, additional functionality and redesigns can be quoted separately."
  },
  {
    "question": "What happens if I cancel?",
    "answer": "Your agreement will set out cancellation terms, ownership and any options to purchase or transfer your website. We will explain these before you sign up."
  }
];
const steps = [
  {
    "title": "Choose Your Website Package",
    "text": "Select Website Starter and complete our simple signup process."
  },
  {
    "title": "Tell Us About Your Business",
    "text": "Share your logo, business details, services, images and the information you want included on your website."
  },
  {
    "title": "We Build Your Website",
    "text": "We'll adapt one of our professional website layouts to suit your business and prepare it for your review."
  },
  {
    "title": "Your Website Goes Live",
    "text": "Once approved, we'll launch your website and take care of the hosting and ongoing technical maintenance covered by your plan."
  }
];
const title = "Pay Monthly Websites from £79 | Local Search Pro";
const description = "Professional pay monthly websites for UK small businesses from £79/month. Mobile-friendly design, hosting, basic SEO and ongoing maintenance.";
const jsonLd = serviceSchema(svc, description);
---
<BaseLayout {title} {description} ctaHref="#pricing" {jsonLd}>
  <Hero title="Pay Monthly Websites for Small Businesses" lead="A Professional Website Without the Big Upfront Cost">
    <div class="stack muted" style="gap:12px;max-width:560px"><p>Your business deserves a website that looks professional, works properly and makes it easy for customers to get in touch.</p><p>At Local Search Pro, we make getting online simple with affordable pay monthly websites designed for small businesses across the UK.</p><p>Whether you're starting a new business, replacing an outdated website or finally getting your business online, we'll help you make a great first impression.</p></div><p class="hero__price">Professional websites from just <span class="hl">£79 per month</span> + VAT.</p><div class="btn-row"><Button variant="primary" href="#pricing" arrow>Get Started</Button></div><ul class="ticks"><li>Mobile-friendly design</li><li>Secure hosting</li><li>Ongoing maintenance</li></ul>
    <Fragment slot="media">Website service graphic: laptop + phone with example site<br><small>(to be supplied)</small></Fragment>
  </Hero>
<section class="section "><div class="container"><div class="split section-head"><div class="stack"><h2 class="h2">Everything You Need From a Small Business Website</h2><h3 class="h3 section-sub">What's Included?</h3></div><div class="stack rule-left muted"><p>Your website is often the first place potential customers go to learn about your business.</p><p>It should explain what you do, build confidence in your services and make taking the next step easy.</p><p>Our pay monthly websites are designed around those essentials, giving you a professional online presence without the expense of a fully bespoke website.</p><p>We take care of the design, setup, hosting and maintenance, leaving you free to concentrate on running your business.</p></div></div><div class="cards"><article class="card"><span class="tick" aria-hidden="true">✓</span><h3 class="h3">Professional Website Design</h3><p>A modern, attractive website built using our proven layouts and tailored to your business, branding and services.</p></article><article class="card"><span class="tick" aria-hidden="true">✓</span><h3 class="h3">Up to Five Pages</h3><p>Room to introduce your business, explain your services, answer common questions and encourage enquiries.</p></article><article class="card"><span class="tick" aria-hidden="true">✓</span><h3 class="h3">Mobile-Friendly Design</h3><p>Your website will work across mobiles, tablets and desktop computers, making it easy for customers to browse wherever they are.</p></article><article class="card"><span class="tick" aria-hidden="true">✓</span><h3 class="h3">Fast, Secure Hosting</h3><p>Reliable hosting, SSL security and routine backups to keep your website running smoothly.</p></article><article class="card"><span class="tick" aria-hidden="true">✓</span><h3 class="h3">Contact Forms and Enquiry Buttons</h3><p>Clear ways for potential customers to get in touch, request a quote or ask questions.</p></article><article class="card"><span class="tick" aria-hidden="true">✓</span><h3 class="h3">Basic Search Engine Optimisation</h3><p>Essential page titles, descriptions, heading structure and other foundational SEO settings to help search engines understand your website.</p></article><article class="card"><span class="tick" aria-hidden="true">✓</span><h3 class="h3">Ongoing Maintenance</h3><p>We handle routine technical maintenance and limited content amendments within your agreed package.</p></article></div></div></section>
<section class="section section--pale" id="pricing"><div class="container"><div class="split" style="align-items:center"><div class="stack"><p class="eyebrow">Pricing</p><h2 class="h2">Simple Pricing. No Big Website Bill.</h2><p class="muted">Our Website Starter package is ideal for small businesses looking for a professional website at an affordable monthly price.</p><p class="muted">Your monthly subscription includes website hosting, maintenance and the agreed ongoing support.</p></div>
<PriceCard {...planCard(svc)} from={false} href={route("signup:Website Starter")} /></div></div></section>
<section class="section "><div class="container"><div class="section-head stack"><h2 class="h2">Why Choose a Pay Monthly Website?</h2></div><div class="why"><div><h3 class="h3">Keep Your Startup Costs Down</h3><p>A new website doesn't have to mean a large initial investment. Spread the cost through manageable monthly payments.</p></div><div><h3 class="h3">Get Online With Less Hassle</h3><p>You won't need to organise separate hosting, technical maintenance or website setup. We take care of those details.</p></div><div><h3 class="h3">Give Customers Confidence</h3><p>A professional website helps demonstrate that your business is established, approachable and ready to help.</p></div><div><h3 class="h3">Make It Easier to Receive Enquiries</h3><p>With clear information, contact forms and prominent calls to action, visitors can quickly find out how to contact you.</p></div><div><h3 class="h3">Keep Your Website Maintained</h3><p>Your website's hosting and routine technical maintenance are included in your ongoing subscription.</p></div></div></div></section>
<LocalBand pale title="Websites Designed for Local Businesses" panelTitle="Need more customers to find your business through Google?" panelText="Our Local SEO packages can help improve your visibility in relevant local searches." ctaHref="/local-seo/" ctaLabel="Explore Local SEO">
    <p class="muted text-pretty">We create affordable websites for businesses across a wide range of industries, including tradespeople, cleaning companies, landscaping businesses, salons, independent retailers and professional services.</p>
    <p class="muted text-pretty">Whether you work in one town or cover several locations, we'll help you present your services clearly and professionally.</p>
  </LocalBand>
<section class="section "><div class="container"><div class="section-head stack"><h2 class="h2">How It Works</h2></div><Steps items={steps} /></div></section>
<section class="section section--pale " id="faq"><div class="container"><FAQ items={faqs} /></div></section>
<CTA variant="banner" bleed curve={false} eyebrow="Ready for a Better Business Website?" eyebrowAs="h2" as="h3" title="Get Online Without the Big Upfront Cost">
    <p class="muted">Give your business a professional website that helps customers understand what you offer and makes it easy for them to contact you.</p><p class="muted">With affordable monthly pricing and ongoing technical support, getting started couldn't be simpler.</p><p class="hero__price">Websites from <span class="hl">£79 per month</span> + VAT.</p>
    <Fragment slot="actions"><Button variant="primary" href="#pricing" arrow>Get Your Website</Button><Button variant="ghost-dark" href={route("contact")}>Ask Us a Question</Button></Fragment>
  </CTA>
</BaseLayout>
