---
import "@fontsource/plus-jakarta-sans/latin-600.css";
import "@fontsource/plus-jakarta-sans/latin-700.css";
import "@fontsource/plus-jakarta-sans/latin-800.css";
import "@fontsource/dm-sans/latin-400.css";
import "@fontsource/dm-sans/latin-500.css";
import "@fontsource/dm-sans/latin-700.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ctaHref?: string;
  /** Extra JSON-LD (e.g. a Service) */
  jsonLd?: Record<string, unknown>;
  /** Dev-only pages: noindex, and bare = no site header/footer */
  noindex?: boolean;
  bare?: boolean;
}
const { title, description, ogImage = "/brand/logos/png/lsp-tagline-on-dark.png", ctaHref, jsonLd, noindex = false, bare = false } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname.replace(/(\.html|\/)$/, "") || "/", site).href;
const ogUrl = new URL(ogImage, site).href;
const business = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Local Search Pro",
  url: site.href,
  logo: new URL("/brand/logos/png/lsp-tagline-on-dark.png", site).href,
  description: "Subscription websites, Local SEO and Google Business Profile management for UK small businesses.",
  areaServed: { "@type": "Country", name: "United Kingdom" },
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/brand/logos/favicon/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/logos/favicon/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/brand/logos/favicon/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/logos/favicon/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Local Search Pro" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#10283F" />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {bare ? <slot /> : (
      <>
        <Header ctaHref={ctaHref} />
        <main id="main"><slot /></main>
        <Footer />
      </>
    )}
  </body>
</html>
