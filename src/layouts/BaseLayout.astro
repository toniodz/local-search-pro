---
import "@fontsource/plus-jakarta-sans/latin-600.css";
import "@fontsource/plus-jakarta-sans/latin-700.css";
import "@fontsource/plus-jakarta-sans/latin-800.css";
import "@fontsource/dm-sans/latin-400.css";
import "@fontsource/dm-sans/latin-500.css";
import "@fontsource/dm-sans/latin-700.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config/site";

interface Props {
  title: string;
  description: string;
  ctaHref?: string;
  /** Extra JSON-LD (e.g. a Service) */
  jsonLd?: Record<string, unknown>;
  /** Dev-only pages: noindex, and bare = no site header/footer */
  noindex?: boolean;
  bare?: boolean;
}
const { title, description, ctaHref, jsonLd, noindex = false, bare = false } = Astro.props;

// Canonical/OG URLs exist only when SITE_URL is configured. The domain is never guessed.
const site = Astro.site;
const pathname = Astro.url.pathname.replace(/index\.html$/, "");
const canonical = site ? new URL(pathname.endsWith("/") ? pathname : pathname + "/", site).href : undefined;
const ogImage = site ? new URL("/brand/logos/png/lsp-tagline-on-dark.png", site).href : undefined;

/** Drop TODO placeholders so they never reach structured data. */
const clean = (o: Record<string, unknown>) =>
  Object.fromEntries(Object.entries(o).filter(([, v]) => v !== undefined && !(typeof v === "string" && v.startsWith("TODO")) && !(Array.isArray(v) && v.length === 0)));

const organization = clean({
  "@context": "https://schema.org", "@type": "Organization",
  name: SITE.name, legalName: SITE.legalName, url: site?.href,
  logo: site ? new URL("/brand/logos/png/lsp-tagline-on-dark.png", site).href : undefined,
  email: SITE.email, telephone: SITE.telephone, sameAs: SITE.sameAs,
  areaServed: { "@type": "Country", name: "United Kingdom" },
});
const website = clean({ "@context": "https://schema.org", "@type": "WebSite", name: SITE.name, url: site?.href, inLanguage: "en-GB" });
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/brand/logos/favicon/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/logos/favicon/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/brand/logos/favicon/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/logos/favicon/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
    <meta name="theme-color" content="#10283F" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {bare ? <slot /> : (
      <>
        <Header ctaHref={ctaHref} />
        <main id="main"><slot /></main>
        <Footer />
      </>
    )}
  </body>
</html>
