---
import icons from "../data/icons.json";
import type { IconName } from "../data/services";
interface Props { name: IconName; size?: number; label?: string }
const { name, size = 24, label } = Astro.props;
const inner = (icons as Record<string, string>)[name];
if (!inner) throw new Error(`Unknown icon: ${name}`);
---
<svg
  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width={size} height={size}
  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
  aria-hidden={label ? undefined : "true"} role={label ? "img" : undefined} aria-label={label}
  focusable="false" set:html={inner}
/>
