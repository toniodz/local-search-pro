---
interface Props { plan?: boolean }
const { plan = false } = Astro.props;
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || "";
---
<form class="form" method="post" action={endpoint || undefined}>
  {!endpoint && <p class="todo">TODO: set PUBLIC_FORM_ENDPOINT so this form can submit.</p>}
  {plan && (
    <div class="field"><label for="plan">Package</label>
      <select id="plan" name="plan">
        <option value="website-starter">Website Starter</option><option value="google-business-profile">Google Business Profile</option>
        <option value="local-seo">Local SEO</option><option value="seo-growth">SEO Growth</option>
      </select></div>
  )}
  <div class="field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required /></div>
  {plan && <div class="field"><label for="business">Business name</label><input id="business" name="business" autocomplete="organization" /></div>}
  <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
  <div class="field"><label for="phone">Phone (optional)</label><input id="phone" name="phone" type="tel" autocomplete="tel" /></div>
  <div class="field"><label for="message">{plan ? "Anything we should know?" : "How can we help?"}</label><textarea id="message" name="message" required={!plan}></textarea></div>
  <div><button class="send btn btn--primary" type="submit">Send</button></div>
</form>
<style>
  .send { display: inline-flex; align-items: center; min-height: 48px; padding: 12.5px 28px; border: 1.5px solid transparent; border-radius: var(--r-btn); background: var(--yellow); color: var(--navy); font: 700 16px var(--font-display); cursor: pointer; }
  .send:hover { background: var(--yellow-hover); }
</style>
