---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * PageHero: H1, lead line, copy and CTAs on the left. On the right, either a supplied
 * image (`image` + `imageAlt`) or a labelled placeholder (the `media` slot).
 */
interface Props { title: string; lead?: string; image?: ImageMetadata; imageAlt?: string }
const { title, lead, image, imageAlt = "" } = Astro.props;
---
<section class="hero on-dark">
  <div class="container hero__grid">
    <div class="stack hero__copy">
      <h1 class="h1">{title}</h1>
      {lead && <p class="hero__lead">{lead}</p>}
      <slot />
    </div>
    {image ? (
      <div class="hero__image">
        <Image src={image} alt={imageAlt} widths={[640, 960, 1280]} sizes="(min-width: 1000px) 560px, 100vw" loading="eager" fetchpriority="high" />
      </div>
    ) : (
      <div class="hero__media" role="img" aria-label="Placeholder"><slot name="media" /></div>
    )}
  </div>
  <img class="swoosh" src="/brand/backgrounds/divider-swoosh-cyan.svg" alt="" width="1440" height="120" />
</section>
<style>
  .hero__image { align-self: center; }
  /* The artwork has a black background: "screen" lets the navy hero show through it. */
  .hero__image :global(img) { display: block; width: 100%; height: auto; mix-blend-mode: screen; }
</style>
