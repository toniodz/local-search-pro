---
/** PageHero: H1, lead line, copy and CTAs on the left; a labelled media placeholder on the right. */
interface Props { title: string; lead?: string }
const { title, lead } = Astro.props;
---
<section class="hero on-dark">
  <div class="container hero__grid">
    <div class="stack hero__copy">
      <h1 class="h1">{title}</h1>
      {lead && <p class="hero__lead">{lead}</p>}
      <slot />
    </div>
    <div class="hero__media" role="img" aria-label="Placeholder"><slot name="media" /></div>
  </div>
  <img class="swoosh" src="/brand/backgrounds/divider-swoosh-cyan.svg" alt="" width="1440" height="120" />
</section>
