---
interface Props { title: string; eyebrow?: string; level?: "h2" | "h3"; class?: string }
const { title, eyebrow, level = "h2", class: className } = Astro.props;
const Tag = level;
---
<div class={className}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag class={level === "h2" ? "h2" : "h3"}>{title}</Tag>
</div>
