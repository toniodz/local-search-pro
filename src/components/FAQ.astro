---
interface Item { question: string; answer: string }
interface Props { items: Item[]; openFirst?: boolean }
const { items, openFirst = true } = Astro.props;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((i) => ({ "@type": "Question", name: i.question, acceptedAnswer: { "@type": "Answer", text: i.answer } })),
};
---
<div class="faq">
  {items.map((i, n) => <details open={openFirst && n === 0}><summary>{i.question}</summary><p>{i.answer}</p></details>)}
</div>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
