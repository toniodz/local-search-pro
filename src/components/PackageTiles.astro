---
import IconTile from "./IconTile.astro";
import { services } from "../data/services";
---
<ul class="pkg-grid">
  {services.map((s) => (
    <li>
      <a href={s.path} class="pkg">
        <IconTile name={s.icon} />
        <span class="pkg__name">{s.name}</span>
        <span class="pkg__price"><strong>£{s.price}</strong>/month + VAT</span>
      </a>
    </li>
  ))}
</ul>
<style>
  .pkg { display: flex; flex-direction: column; gap: 12px; height: 100%; background: #fff; border: 1px solid var(--border); border-radius: var(--r-card); padding: 24px; text-decoration: none; color: var(--navy); transition: border-color 0.15s, box-shadow 0.15s; }
  .pkg:hover { border-color: var(--cyan); box-shadow: 0 14px 34px -20px rgba(16, 40, 63, 0.4); color: var(--navy); }
  .pkg__name { font-family: var(--font-display); font-weight: 700; font-size: 18px; line-height: 1.3; }
  .pkg__price { margin-top: auto; color: var(--ink-2); font-size: 15px; }
  .pkg__price strong { font-family: var(--font-display); font-size: 28px; color: var(--navy); letter-spacing: -0.02em; }
</style>
