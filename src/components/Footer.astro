---
import Logo from "./Logo.astro";
import { services } from "../data/services";
import { route } from "../config/routes";
---
<footer class="site-footer">
  <div class="container footer__grid">
    <div class="stack" style="gap:12px">
      <Logo />
      <p>Local Search Pro — Affordable websites and local SEO for UK businesses.</p>
    </div>
    <nav aria-label="Services" class="footer__links">
      {services.map((s) => <a href={s.path}>{s.id === "local-seo" ? "Local SEO" : s.name}</a>)}
      <a href={route("pricing")}>Pricing</a>
      <a href={route("contact")}>Contact</a>
    </nav>
    <nav aria-label="Legal" class="footer__legal-links">
      <a href="/privacy/">Privacy Policy</a>
      <a href="/cookies/">Cookie Policy</a>
      <a href="/terms/">Website Terms of Use</a>
    </nav>
    <p class="footer__legal">All prices exclude VAT. No Google rankings, leads or results are guaranteed.</p>
  </div>
</footer>
