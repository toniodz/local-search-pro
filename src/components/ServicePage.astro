---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "./Hero.astro";
import Button from "./Button.astro";
import PriceCard from "./PriceCard.astro";
import CTA from "./CTA.astro";
import { services } from "../data/services";
interface Props { id: string; title: string; description: string }
const { id, title, description } = Astro.props;
const s = services.find((x) => x.id === id)!;
const jsonLd = {
  "@context": "https://schema.org", "@type": "Service", name: s.name,
  provider: { "@type": "LocalBusiness", name: "Local Search Pro" }, areaServed: { "@type": "Country", name: "United Kingdom" },
  offers: { "@type": "Offer", priceCurrency: "GBP", price: String(s.price) },
};
---
<BaseLayout {title} {description} {jsonLd} ctaHref="#pricing">
  <Hero eyebrow={s.name} title={s.name}>
    <p class="todo">TODO: copy for this page</p>
    <p class="hero__price">From <strong>£{s.price} per month</strong> + VAT.</p>
    <div class="btn-row"><Button href="#pricing" arrow>Get Started</Button></div>
  </Hero>
  <section class="section section--pale" id="pricing">
    <div class="container split" style="align-items:center">
      <div class="stack">
        <h2 class="h2">TODO: pricing heading</h2>
        <p class="muted">TODO: copy</p>
      </div>
      <PriceCard name={s.name} icon={s.icon} price={s.price} setup={s.setup} features={s.features} cta={s.cta} href={s.href} featured={s.featured} />
    </div>
  </section>
  <section class="section">
    <div class="container"><CTA variant="inline" title={`${s.name} from £${s.price} per month + VAT.`} text="TODO: copy" primary={{ label: "Get Started", href: s.href }} secondary={{ label: "Ask Us a Question", href: "/contact" }} /></div>
  </section>
</BaseLayout>
